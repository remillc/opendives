<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier (android:fullBackupContent). The repository access
     (address, user name, encrypted token) never leaves the device in a
     backup; see plugins/opendives-core, GitRemoteStore. -->
<full-backup-content>
    <exclude domain="file" path="git-remote.bin" />
    <exclude domain="file" path="git-remote.bin.tmp" />
</full-backup-content>
