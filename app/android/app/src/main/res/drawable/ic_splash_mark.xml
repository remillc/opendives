<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen mark: the light "Hublot" logo (docs/brand/opendives-icon-light-fullbleed.svg) without its background. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- The porthole: a disc (circle r 30). -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M24,54a30,30 0,1 0,60 0a30,30 0,1 0,-60 0Z" />
    <!-- Water at about 40 %, clipped to the porthole (circle r 29). -->
    <group>
        <clip-path android:pathData="M25,54a29,29 0,1 0,58 0a29,29 0,1 0,-58 0Z" />
        <path android:pathData="M20,61 Q32,55 44,61 T68,61 T92,61 V100 H20 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="58"
                    android:endX="54"
                    android:endY="100">
                    <item android:offset="0" android:color="#FFFBE3B2" />
                    <item android:offset="1" android:color="#FFB4530F" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
    <!-- The ring, only under the water: an arc from one end of the waterline to the other. -->
    <!-- Above the water, the circle completed in grey: small sizes only (spec, "Logo", size rule). -->
    <path
        android:pathData="M24.83,61 A30,30 0 1,1 83.17,61"
        android:strokeColor="#FFA3A5A8"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M24.83,61 A30,30 0 0,0 83.17,61"
        android:strokeColor="#FF1F2124"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <!-- Bubbles. -->
    <path android:fillColor="#FF1F2124" android:pathData="M59,44a3,3 0,1 0,6 0a3,3 0,1 0,-6 0Z" />
    <path android:fillColor="#FF1F2124" android:pathData="M54.4,36.5a2.1,2.1 0,1 0,4.2 0a2.1,2.1 0,1 0,-4.2 0Z" />
</vector>
